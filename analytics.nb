Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Combine", " ", "Dirac", " ", "spinors", " ", "and", " ", "matrices", " ", 
    "evaluation", " ", "operations"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DiracEvaluate", "[", 
     RowBox[{"exp_", ",", 
      RowBox[{"repPre_", ":", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"momentumList_", ":", 
       RowBox[{"{", "}"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "Result", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Result", "=", "exp"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"uncontract", " ", "all", " ", "momenta"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Result", "=", 
          RowBox[{"Uncontract", "[", 
           RowBox[{"Result", ",", 
            RowBox[{"momentumList", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"Pair", "->", 
             RowBox[{"{", "Polarization", "}"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "momentumList", "]"}]}], "}"}]}], "]"}], 
       ";", " ", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Turn", " ", "Result", " ", "into", " ", "a", " ", "list", " ", "of", 
         " ", "mono", " ", "terms"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Result", "=", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Result", "//.", "repPre"}], "//.", "repDiracStructure"}],
            "//.", 
           RowBox[{"{", 
            RowBox[{"Eps", "->", "EpsLC"}], "}"}]}], "]"}], "//.", 
         "repFourVector"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"In", " ", "FeynCalc"}], ",", " ", 
         RowBox[{
          RowBox[{"Eps", "[", 
           RowBox[{"0", ",", "__"}], "]"}], "=", 
          RowBox[{
           RowBox[{"0", " ", "and", " ", 
            RowBox[{"Pair", "[", 
             RowBox[{"0", ",", "__"}], "]"}]}], "=", "0"}]}], ",", " ", 
         RowBox[{
          RowBox[{"hence", " ", "repFourVector", " ", "and", " ", "Eps"}], "->",
           "EpsLC"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Result", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "Result", "]"}], "===", "Plus"}], ",", 
          RowBox[{"List", "@@", "Result"}], ",", 
          RowBox[{"{", "Result", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "replace", " ", "Dirac", " ", "structure", " ", "and", " ", "enforce",
          " ", "repeated", " ", "indices", " ", "summation", " ", 
         "individually", " ", "for", " ", "each", " ", "term"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Result", "=", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RepeatedLorentzIndexSummation", "[", "#", "]"}], "&"}], "/@",
           "Result"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Release", " ", "Hold", " ", "and", " ", "allow", " ", "matrix", " ", 
         "multiplication", " ", "to", " ", "happen"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Result", "=", 
        RowBox[{
         RowBox[{"ReleaseHold", "[", 
          RowBox[{"Result", "//.", "repPre"}], "]"}], "//.", 
         "repFourVector"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Dimensions", "[", "Result", "]"}], "==", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Result", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"Return", "[", "Result", "]"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
