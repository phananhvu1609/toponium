Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Other", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rep2to2NR", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "->", "0"}], ",", 
       RowBox[{"mt", "->", 
        RowBox[{"Mtt", "/", "2"}]}], ",", 
       RowBox[{"theta", "->", "0"}]}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Non", "-", "relativistic"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"repIndices2to2NR", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Glu1", "->", "a"}], ",", 
       RowBox[{"Glu2", "->", "b"}], ",", 
       RowBox[{"Glu5", "->", "c"}], ",", 
       RowBox[{"Col3", "->", "i"}], ",", 
       RowBox[{"Col4", "->", "j"}], ",", 
       RowBox[{"Col1", "->", "l"}], ",", 
       RowBox[{"Col2", "->", "n"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"repToLaTeX2to2NR", "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<M_{\\\\text{tt}}\>\"", "->", "\"\<\\\\Mtt\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
       "\"\<\\\\varepsilon _-\\\\left(k_2\\\\right)\>\"", "->", 
        "\"\<\\\\varepsilon _{2-}\>\""}], ",", 
       RowBox[{
       "\"\<\\\\varepsilon _-\\\\left(k_1\\\\right)\>\"", "->", 
        "\"\<\\\\varepsilon _{1-}\>\""}], ",", "\[IndentingNewLine]", 
       RowBox[{
       "\"\<\\\\varepsilon _+\\\\left(k_2\\\\right)\>\"", "->", 
        "\"\<\\\\varepsilon _{2+}\>\""}], ",", 
       RowBox[{
       "\"\<\\\\varepsilon _+\\\\left(k_1\\\\right)\>\"", "->", 
        "\"\<\\\\varepsilon _{1+}\>\""}], ",", "\[IndentingNewLine]", 
       RowBox[{
       "\"\<\\\\eta _+\\\\left(p_2\\\\right)\>\"", "->", 
        "\"\<\\\\varsigma _{\\\\bart \\\\uparrow}\>\""}], ",", 
       RowBox[{
       "\"\<\\\\eta _-\\\\left(p_2\\\\right)\>\"", "->", 
        "\"\<\\\\varsigma _{\\\\bart \\\\downarrow}\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
       "\"\<\\\\xi _+\\\\left(p_1\\\\right)\>\"", "->", 
        "\"\<\\\\varsigma _{t \\\\uparrow}\>\""}], ",", 
       RowBox[{
       "\"\<\\\\xi _-\\\\left(p_1\\\\right)\>\"", "->", 
        "\"\<\\\\varsigma _{t \\\\downarrow}\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
       "\"\<\\\\eta _+\\\\left(k_2\\\\right)\>\"", "->", 
        "\"\<\\\\varsigma _{\\\\barq \\\\uparrow}\>\""}], ",", 
       RowBox[{
       "\"\<\\\\eta _-\\\\left(k_2\\\\right)\>\"", "->", 
        "\"\<\\\\varsigma _{\\\\barq \\\\downarrow}\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
       "\"\<\\\\xi _+\\\\left(k_1\\\\right)\>\"", "->", 
        "\"\<\\\\varsigma _{q \\\\uparrow}\>\""}], ",", 
       RowBox[{
       "\"\<\\\\xi _-\\\\left(k_1\\\\right)\>\"", "->", 
        "\"\<\\\\varsigma _{q \\\\downarrow}\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<p^2\>\"", "->", "\"\<\\\\abs{\\\\bp^*}^2\>\""}], ",", 
