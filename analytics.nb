Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Compute", " ", "spherical", " ", "harmonics", " ", "expansion"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ProjectSphericalHarmonics", "[", 
      RowBox[{"exp_", ",", "ll_", ",", "mm_", ",", 
       RowBox[{"OptionsPattern", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"angleL", "->", "theta"}], ",", 
          RowBox[{"angleM", "->", "phi"}]}], "}"}], "]"}]}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Assuming", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<angleL\>\"", "]"}], ">", "0"}], "&&", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<angleM\>\"", "]"}], ">", "0"}]}], 
       ",", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{"exp", "*", 
             RowBox[{"Conjugate", "[", 
              RowBox[{"SphericalHarmonicY", "[", 
               RowBox[{"ll", ",", "mm", ",", 
                RowBox[{"OptionValue", "[", "\"\<angleL\>\"", "]"}], ",", 
                RowBox[{"OptionValue", "[", "\"\<angleM\>\"", "]"}]}], "]"}], 
              "]"}]}], "]"}], "*", 
           RowBox[{"Sin", "[", 
            RowBox[{"OptionValue", "[", "\"\<angleL\>\"", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<angleM\>\"", "]"}], ",", "0", 
            ",", 
            RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<angleL\>\"", "]"}], ",", "0", 
            ",", "Pi"}], "}"}]}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Find", " ", "all", " ", "spherical", " ", "harmonics"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SphericalHarmonicExpansion", "[", 
      RowBox[{"exp_", ",", "Lmax_", ",", 
       RowBox[{"OptionsPattern", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"MomentumRescale", "->", "1"}], ",", 
          RowBox[{"angleL", "->", "theta"}], ",", 
          RowBox[{"angleM", "->", "phi"}]}], "}"}], "]"}]}], "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ll", ",", "mm"}], "}"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"ProjectSphericalHarmonics", "[", 
              RowBox[{"exp", ",", "ll", ",", "mm", ",", 
               RowBox[{"angleL", "->", 
                RowBox[{"OptionValue", "[", "\"\<angleL\>\"", "]"}]}], ",", 
               RowBox[{"angleM", "->", 
                RowBox[{"OptionValue", "[", "\"\<angleM\>\"", "]"}]}]}], 
              "]"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<MomentumRescale\>\"", "]"}], 
              "^", "ll"}], ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"mm", ",", 
           RowBox[{"-", "ll"}], ",", "ll"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ll", ",", "0", ",", "Lmax"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
