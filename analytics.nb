        RowBox[{"mom_", ",", "minus"}], "]"}], "->", 
       RowBox[{"EtaDown", "[", "mom", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Xi", "[", 
        RowBox[{"mom_", ",", "plus"}], "]"}], "->", 
       RowBox[{"XiUp", "[", "mom", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Xi", "[", 
        RowBox[{"mom_", ",", "minus"}], "]"}], "->", 
       RowBox[{"XiDown", "[", "mom", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Pol", "[", 
        RowBox[{"mom_", ",", "plus"}], "]"}], "->", 
       RowBox[{
        SubscriptBox["\[CurlyEpsilon]", "+"], "[", "mom", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Pol", "[", 
        RowBox[{"mom_", ",", "minus"}], "]"}], "->", 
       RowBox[{
        SubscriptBox["\[CurlyEpsilon]", "-"], "[", "mom", "]"}]}], ",", 
      RowBox[{"RelMom", "->", "p"}], ",", 
      RowBox[{"OutMom", "->", "P"}], ",", 
      RowBox[{"RelInMom", "->", "k"}]}], "}"}]}], ";"}]}]], "Input",
