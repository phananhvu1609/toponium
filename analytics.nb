Cell[BoxData[
 RowBox[{
  RowBox[{"SpinProjectorProduction", "[", 
   RowBox[{"S_", ",", 
    RowBox[{"Mom1_", ":", 
     RowBox[{"Momentum", "[", "OutMom1", "]"}]}], ",", 
    RowBox[{"Mom2_", ":", 
     RowBox[{"Momentum", "[", "OutMom2", "]"}]}], ",", 
    RowBox[{"Mass_", ":", 
     RowBox[{"FCGV", "[", "\"\<MT\>\"", "]"}]}], ",", 
    RowBox[{"EnCM_", ":", 
     RowBox[{"Mtt", "/", "2"}]}]}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"S", "==", "0"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"DiracGamma", "[", "5", "]"}], ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"DiracGamma", "[", 
          RowBox[{"Mom1", "+", "Mom2"}], "]"}], "+", 
         RowBox[{"2", "*", "EnCM"}]}], ")"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "EnCM"}], ")"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"2", 
       RowBox[{"Sqrt", "[", "2", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"EnCM", "+", "Mass"}], ")"}]}], ")"}]}], ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"S", "==", "1"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"DiracGamma", "[", 
          RowBox[{"Momentum", "[", 
           RowBox[{"Polarization", "[", 
            RowBox[{"OutMom", ",", 
             RowBox[{"-", "I"}]}], "]"}], "]"}], "]"}], ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"DiracGamma", "[", 
            RowBox[{"Mom1", "+", "Mom2"}], "]"}], "+", 
           RowBox[{"2", "*", "EnCM"}]}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "EnCM"}], ")"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"2", 
         RowBox[{"Sqrt", "[", "2", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"EnCM", "+", "Mass"}], ")"}]}], ")"}]}]}], "]"}]}], 
   "]"}]}]], "Input",
