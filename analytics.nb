          RowBox[{"OptionValue", "[", "repExp", "]"}]}], "]"}], "]"}], ",", 
       RowBox[{"OptionValue", "[", "repString", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SphericalHarmonicCoeffLaTex", "[", 
     RowBox[{"exp_", ",", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"repExp", "->", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"repString", "->", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"coeffSuperscript", "->", "\"\<\>\""}], ",", 
         RowBox[{"Prefactor", "->", "1"}]}], "}"}], "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "CoeffList", ",", "Output", ",", "superscript", ",", "RHSOutput"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"CoeffList", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"exp", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"superscript", "=", 
        RowBox[{"\"\<^{\>\"", "<>", 
         RowBox[{"OptionValue", "[", "\"\<coeffSuperscript\>\"", "]"}], "<>", 
         "\"\<}\>\""}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Output", "=", "\"\<\>\""}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"Not", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"CoeffList", "[", 
               RowBox[{"[", "inc", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "===", "0"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"RHSOutput", "=", 
             RowBox[{"ToLaTeX", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"CoeffList", "[", 
                 RowBox[{"[", "inc", "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"repExp", "->", 
                RowBox[{"OptionValue", "[", "\"\<repExp\>\"", "]"}]}], ",", 
               RowBox[{"repString", "->", 
                RowBox[{"OptionValue", "[", "\"\<repString\>\"", "]"}]}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"Not", "[", 
               RowBox[{
                RowBox[{"OptionValue", "[", "\"\<Prefactor\>\"", "]"}], "===",
                 "1"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Head", "[", 
                  RowBox[{
                   RowBox[{"CoeffList", "[", 
                    RowBox[{"[", "inc", "]"}], "]"}], "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}], "===", "Plus"}], 
                ",", 
                RowBox[{"RHSOutput", "=", 
                 RowBox[{
                 "\"\<\\\\qty[\>\"", "<>", "RHSOutput", "<>", "\"\<]\>\"", "<>", 
                  RowBox[{"ToString", "[", 
                   RowBox[{"OptionValue", "[", "\"\<Prefactor\>\"", "]"}], 
                   "]"}]}]}], ",", "\[IndentingNewLine]", 
                RowBox[{"RHSOutput", "=", 
                 RowBox[{"RHSOutput", "<>", 
                  RowBox[{"ToString", "[", 
                   RowBox[{"OptionValue", "[", "\"\<Prefactor\>\"", "]"}], 
                   "]"}]}]}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Output", "=", 
             RowBox[{
             "Output", "<>", "\"\<a\>\"", "<>", "superscript", "<>", 
              "\"\<_{\>\"", "<>", 
              RowBox[{"ToString", "[", 
               RowBox[{
                RowBox[{"CoeffList", "[", 
                 RowBox[{"[", "inc", "]"}], "]"}], "[", 
                RowBox[{"[", 
