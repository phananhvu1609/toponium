Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Produce", " ", "the", " ", "replacement", " ", "rule", " ", "for", " ", 
    "setting", " ", "Eta", " ", "and", " ", "Xi", " ", "corresponding", " ", 
    "to", " ", "Mom", " ", "to", " ", "up", " ", 
    RowBox[{"(", 
     RowBox[{"SpinProj", " ", ">", " ", "0"}], ")"}], " ", "or", " ", "down", 
    " ", 
    RowBox[{"(", 
     RowBox[{"SpinProj", " ", "<", " ", "0"}], ")"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"repProjectSpin", "[", 
     RowBox[{"Mom_", ",", "SpinProj_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Head", "[", "Mom", "]"}], "===", "List"}], ",", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"repProjectSpin", "[", 
          RowBox[{
           RowBox[{"Mom", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"SpinProj", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "Mom", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"SpinProj", ">", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Eta", "[", 
            RowBox[{"Mom", ",", "plus"}], "]"}], ":>", "1"}], ",", 
          RowBox[{
           RowBox[{"Eta", "[", 
            RowBox[{"Mom", ",", "minus"}], "]"}], "->", "0"}], ",", 
          RowBox[{
           RowBox[{"Xi", "[", 
            RowBox[{"Mom", ",", "plus"}], "]"}], ":>", "1"}], ",", 
          RowBox[{
           RowBox[{"Xi", "[", 
            RowBox[{"Mom", ",", "minus"}], "]"}], "->", "0"}], ",", 
          RowBox[{
           RowBox[{"Pol", "[", 
            RowBox[{"Mom", ",", "plus"}], "]"}], ":>", "1"}], ",", 
          RowBox[{
           RowBox[{"Pol", "[", 
            RowBox[{"Mom", ",", "minus"}], "]"}], "->", "0"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"SpinProj", "<", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Eta", "[", 
              RowBox[{"Mom", ",", "plus"}], "]"}], ":>", "0"}], ",", 
            RowBox[{
             RowBox[{"Eta", "[", 
              RowBox[{"Mom", ",", "minus"}], "]"}], "->", "1"}], ",", 
            RowBox[{
             RowBox[{"Xi", "[", 
              RowBox[{"Mom", ",", "plus"}], "]"}], ":>", "0"}], ",", 
            RowBox[{
             RowBox[{"Xi", "[", 
              RowBox[{"Mom", ",", "minus"}], "]"}], "->", "1"}], ",", 
            RowBox[{
             RowBox[{"Pol", "[", 
              RowBox[{"Mom", ",", "plus"}], "]"}], ":>", "0"}], ",", 
            RowBox[{
             RowBox[{"Pol", "[", 
              RowBox[{"Mom", ",", "minus"}], "]"}], "->", "1"}]}], "}"}], ",", 
          RowBox[{"Throw", "[", 
           RowBox[{
           "\"\<SpinProj cannot be 0\>\"", ",", "\"\<InvalidArgument\>\""}], 
           "]"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.957258515672189*^9, 3.95725862678755*^9}, {
