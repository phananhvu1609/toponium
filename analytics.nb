Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ProjectSpinProduction", "[", 
    RowBox[{"exp_", ",", "S_", ",", 
     RowBox[{"Mass_", ":", 
      RowBox[{"FCGV", "[", "\"\<MT\>\"", "]"}]}], ",", 
     RowBox[{"EnCM_", ":", 
      RowBox[{"Mtt", "/", "2"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "USpinor", ",", "USpinorList", ",", "MomU", ",", "VSpinor", ",", 
       "VSpinorList", ",", "MomV", ",", "ProjectedExpression", ",", 
       "SpinorChain", ",", "SpinorChainList"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"USpinorList", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"exp", ",", 
          RowBox[{"Spinor", "[", 
           RowBox[{
            RowBox[{"Momentum", "[", "__", "]"}], ",", "Mass", ",", "__"}], 
           "]"}], ",", "Infinity"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"VSpinorList", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"exp", ",", 
          RowBox[{"Spinor", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Momentum", "[", "__", "]"}]}], ",", "Mass", ",", "__"}],
            "]"}], ",", "Infinity"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SpinorChainList", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"FCDiracIsolate", "[", "exp", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"FCGV", "[", "\"\<DiracChain\>\"", "]"}], "[", "exp2_", 
            "]"}], "/;", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"exp2", ",", "Mass", ",", "Infinity"}], "]"}]}], ",", 
          "Infinity"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Or", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "USpinorList", "]"}], "!=", "1"}], ",", 
          RowBox[{
           RowBox[{"Length", "[", "VSpinorList", "]"}], "!=", "1"}]}], "]"}], 
        ",", 
        RowBox[{
         RowBox[{"Throw", "[", "\"\<Too many spinors detected\>\"", "]"}], 
         ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"VSpinor", "=", 
       RowBox[{"VSpinorList", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"MomV", "=", 
       RowBox[{"VSpinor", "//.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Spinor", "[", 
           RowBox[{
            RowBox[{"-", "mom_"}], ",", "__", ",", "__"}], "]"}], "->", 
          "mom"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"USpinor", "=", 
       RowBox[{"USpinorList", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"MomU", "=", 
       RowBox[{"USpinor", "//.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Spinor", "[", 
           RowBox[{"mom_", ",", "__", ",", "__"}], "]"}], "->", "mom"}], 
         "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"SpinorChain", "=", 
       RowBox[{"SpinorChainList", "//.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"FCGV", "[", "\"\<DiracChain\>\"", "]"}], "[", "subexp__", 
           "]"}], "->", "subexp"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ProjectedExpression", "=", 
       RowBox[{"FermionSpinSum", "[", 
        RowBox[{"SpinorChain", "*", 
         RowBox[{"VSpinor", ".", 
          RowBox[{"SpinProjectorProduction", "[", 
           RowBox[{"S", ",", "MomU", ",", "MomV", ",", "Mass", ",", "EnCM"}], 
           "]"}], ".", "USpinor"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "SpinorChain", "]"}], ">", "0"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"exp", "//.", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"SpinorChain", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "->", 
             RowBox[{"ProjectedExpression", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"Length", "[", "SpinorChain", "]"}]}], "}"}]}], "]"}]}],
          "]"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"exp", "//.", 
          RowBox[{"{", 
           RowBox[{"SpinorChain", "->", "ProjectedExpression"}], "}"}]}], 
         "]"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.959937338973572*^9, 3.959937354956811*^9}, {
