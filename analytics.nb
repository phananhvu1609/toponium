Cell[BoxData[{
 RowBox[{
  RowBox[{"ZeroMatrix2", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GammaMatrix", "[", "ind_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"ind", "==", "0"}], ",", 
    RowBox[{"ArrayFlatten", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ZeroMatrix2", ",", 
         RowBox[{"PauliMatrix", "[", "0", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "0", "]"}], ",", "ZeroMatrix2"}], 
        "}"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"Or", "[", 
       RowBox[{
        RowBox[{"ind", "==", "1"}], ",", 
        RowBox[{"ind", "==", "2"}], ",", 
        RowBox[{"ind", "==", "3"}]}], "]"}], ",", 
      RowBox[{"ArrayFlatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ZeroMatrix2", ",", 
           RowBox[{"PauliMatrix", "[", "ind", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"PauliMatrix", "[", "ind", "]"}]}], ",", "ZeroMatrix2"}], 
          "}"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ind", "==", "5"}], ",", 
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
             "ZeroMatrix2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ZeroMatrix2", ",", 
             RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "}"}]}], "}"}], 
         "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9562400233620234`*^9, 3.9562401349273353`*^9}, {
