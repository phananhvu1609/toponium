Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Extract", " ", "spinor", " ", "structure"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ProjectSpinStructure", "[", 
     RowBox[{
     "exp_", ",", "Sinit_", ",", "Minit_", ",", "Sfin_", ",", "Mfin_", ",", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InMomList", "->", 
          RowBox[{"{", 
           RowBox[{"InMom1", ",", "InMom2"}], "}"}]}], ",", 
         RowBox[{"OutMomList", "->", 
          RowBox[{"{", 
           RowBox[{"OutMom1", ",", "OutMom2"}], "}"}]}]}], "}"}], "]"}]}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Result", ",", "InList", ",", "OutList"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"InList", "=", 
        RowBox[{"OptionValue", "[", "InMomList", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"OutList", "=", 
        RowBox[{"OptionValue", "[", "OutMomList", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"Or", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "InList", "]"}], "!=", "2"}], ",", 
           RowBox[{
            RowBox[{"Length", "[", "OutList", "]"}], "!=", "2"}]}], "]"}], 
         ",", 
         RowBox[{"Throw", "[", 
          RowBox[{
          "\"\<Length of InMomList and OutMomList must be 2\>\"", ",", 
           "\"\<InvalidArgument\>\""}], "]"}]}], "]"}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Assume", " ", "only", " ", "2", " ", "incoming", " ", "and", " ", 
         "2", " ", "outgoing", " ", "momenta"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"exp", ",", 
           RowBox[{"Pol", "[", "__", "]"}], ",", "Infinity"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"And", "[", 
             RowBox[{
              RowBox[{"Sinit", "==", "1"}], ",", 
              RowBox[{"Minit", "==", "1"}]}], "]"}], ",", 
            RowBox[{"Result", "=", 
             RowBox[{"(", 
              RowBox[{"exp", "//.", 
               RowBox[{"repProjectSpin", "[", 
                RowBox[{"InList", ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"And", "[", 
                RowBox[{
                 RowBox[{"Sinit", "==", "1"}], ",", 
                 RowBox[{"Minit", "==", 
                  RowBox[{"-", "1"}]}]}], "]"}], ",", 
               RowBox[{"Result", "=", 
                RowBox[{"(", 
                 RowBox[{"exp", "//.", 
                  RowBox[{"repProjectSpin", "[", 
                   RowBox[{"InList", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ")"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"And", "[", 
                   RowBox[{
                    RowBox[{"Sinit", "==", "1"}], ",", 
                    RowBox[{"Minit", "==", "0"}]}], "]"}], ",", 
                  RowBox[{"Result", "=", 
                   RowBox[{
                    RowBox[{"1", "/", 
                    RowBox[{"Sqrt", "[", "2", "]"}]}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"exp", "//.", 
                    RowBox[{"repProjectSpin", "[", 
                    RowBox[{"InList", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ")"}], "+", 
                    RowBox[{"(", 
                    RowBox[{"exp", "//.", 
                    RowBox[{"repProjectSpin", "[", 
                    RowBox[{"InList", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], ")"}]}],
                     ")"}]}]}], ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"And", "[", 
                    RowBox[{
                    RowBox[{"Sinit", "==", "0"}], ",", 
                    RowBox[{"Minit", "==", "0"}]}], "]"}], ",", 
                    RowBox[{"Result", "=", 
                    RowBox[{
                    RowBox[{"1", "/", 
                    RowBox[{"Sqrt", "[", "2", "]"}]}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"exp", "//.", 
                    RowBox[{"repProjectSpin", "[", 
                    RowBox[{"InList", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ")"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"exp", "//.", 
                    RowBox[{"repProjectSpin", "[", 
                    RowBox[{"InList", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], ")"}]}],
                     ")"}]}]}], ",", 
                    RowBox[{
                    RowBox[{"Throw", "[", 
                    RowBox[{
                    "\"\<Unrecognizable Sinit and/or Minit\>\"", ",", 
                    "\"\<InvalidArgument\>\""}], "]"}], ";"}]}], "]"}], 
                   ";"}]}], "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"And", "[", 
             RowBox[{
              RowBox[{"Sinit", "==", "2"}], ",", 
              RowBox[{"Minit", "==", "2"}]}], "]"}], ",", 
            RowBox[{"Result", "=", 
             RowBox[{"(", 
              RowBox[{"exp", "//.", 
               RowBox[{"repProjectSpin", "[", 
                RowBox[{"InList", ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"And", "[", 
                RowBox[{
                 RowBox[{"Sinit", "==", "2"}], ",", 
                 RowBox[{"Minit", "==", 
                  RowBox[{"-", "2"}]}]}], "]"}], ",", 
               RowBox[{"Result", "=", 
                RowBox[{"(", 
                 RowBox[{"exp", "//.", 
                  RowBox[{"repProjectSpin", "[", 
                   RowBox[{"InList", ",", 
                    RowBox[{"{", 
