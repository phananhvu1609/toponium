Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ChiPlus", "[", "ind_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], "*", 
         RowBox[{
          RowBox[{"Phi", "[", "ind", "]"}], "/", "2"}]}], "]"}], "*", 
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{"Theta", "[", "ind", "]"}], "/", "2"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", "*", 
         RowBox[{
          RowBox[{"Phi", "[", "ind", "]"}], "/", "2"}]}], "]"}], "*", 
       RowBox[{"Sin", "[", 
        RowBox[{
         RowBox[{"Theta", "[", "ind", "]"}], "/", "2"}], "]"}]}], "}"}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ChiMinus", "[", "ind_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], "*", 
           RowBox[{
            RowBox[{"Phi", "[", "ind", "]"}], "/", "2"}]}], "]"}]}], "*", 
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"Theta", "[", "ind", "]"}], "/", "2"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", "*", 
          RowBox[{
           RowBox[{"Phi", "[", "ind", "]"}], "/", "2"}]}], "]"}], "*", 
        RowBox[{"Cos", "[", 
         RowBox[{
          RowBox[{"Theta", "[", "ind", "]"}], "/", "2"}], "]"}]}], "}"}]}], 
     "}"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "Particle", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SpinorXi", "[", 
     RowBox[{"ind_", ",", 
      RowBox[{"Spin_", ":", "0"}]}], "]"}], ":=", 
    RowBox[{"If", "[", 
