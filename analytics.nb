Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Export", " ", "to", " ", "LaTeX"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ToLaTeX", "[", 
      RowBox[{"exp_", ",", 
       RowBox[{"OptionsPattern", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"repExp", "->", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"repString", "->", 
           RowBox[{"{", "}"}]}]}], "}"}], "]"}]}], "]"}], ":=", 
     RowBox[{"StringReplace", "[", 
