Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Function", " ", "to", " ", "carry", " ", "out", " ", "summation", " ", 
    "over", " ", "repeated", " ", "Lorentz", " ", "indices"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"RepeatedLorentzIndexSummation", "[", "exp_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"RepeatedIndexList", ",", "Result"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Result", "=", "exp"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Look", " ", "for", " ", "all", " ", "repeated", " ", "Lorentz", " ", 
        "indices"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"RepeatedIndexList", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"exp", ",", 
          RowBox[{"LorentzIndex", "[", "__", "]"}], ",", "Infinity"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"For", " ", "each", " ", "repeated", " ", "index"}], ","}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Carry", " ", "out", " ", "summation", " ", "over", " ", "repeated", 
         " ", "index", " ", "i"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Result", "=", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Metric", "[", 
              RowBox[{"mu", ",", "mu"}], "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"Result", "//.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"LorentzIndex", "[", 
                  RowBox[{"RepeatedIndexList", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}], "->", "mu"}], 
                "}"}]}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"mu", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "RepeatedIndexList", "]"}]}], "}"}]}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "Result", "]"}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
