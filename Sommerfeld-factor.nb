Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{"1", "/", 
   RowBox[{"z", "^", "3"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.990615397295618*^9, 
  3.990615411105606*^9}},ExpressionUUID->"3f2416ad-fba4-1241-94d0-\
c8b0de1ba539"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Coth", "[", "z", "]"}], "/", 
   RowBox[{"z", "^", "3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//.", 
  RowBox[{"{", 
   RowBox[{"z", "->", 
    RowBox[{"0.1", "+", 
     RowBox[{"I", "*", "x"}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Abs", "[", "%", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.990616062130268*^9, 3.9906161364983044`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"48879e59-b21a-304c-b335-7495ca4e9994"],

Cell[BoxData[
 FractionBox[
  RowBox[{"Coth", "[", 
   RowBox[{"0.1`", "\[VeryThinSpace]", "+", 
    RowBox[{"\[ImaginaryI]", " ", "x"}]}], "]"}], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"0.1`", "\[VeryThinSpace]", "+", 
     RowBox[{"\[ImaginaryI]", " ", "x"}]}], ")"}], "3"]]], "Output",
