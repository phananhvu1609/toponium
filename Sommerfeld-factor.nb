Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"n", ">", "0"}], ",", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", 
         RowBox[{"kappa", "/", "n"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"3", "/", "2"}], ")"}]}], "*", 
      RowBox[{"1", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{"n", "^", "2"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}]}], "*", "n"}], "]"}], "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"4", "*", "Pi"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9906737805443897`*^9, 3.9906738652639484`*^9}, {
