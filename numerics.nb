Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pgg", "[", "z_", "]"}], ":=", 
   RowBox[{"2", "*", "CA", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "z"}], ")"}]}], "+", 
      RowBox[{"1", "/", "z"}], "+", 
      RowBox[{"z", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "z"}], ")"}]}], "-", "2"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pggz", "[", "z_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "x"}], ")"}], "*", 
       RowBox[{"Pgg", "[", "x", "]"}]}], "]"}], "//.", 
